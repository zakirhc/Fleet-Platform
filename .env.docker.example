# Copy to .env.docker and replace every value before deployment.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=traccar
MYSQL_USER=traccar
MYSQL_PASSWORD=change-this-database-password

# Used by the Fleet Platform backend.
DATABASE_URL=mysql://traccar:change-this-database-password@mysql:3306/traccar
JWT_SECRET=replace-with-a-random-secret-of-at-least-16-characters
BOOTSTRAP_ADMIN_SECRET=use-once-to-promote-the-first-company-admin
PORT=3000
NODE_ENV=production
# Comma-separated public origins only when Fleet is served from another origin.
# Leave empty for the default same-origin frontend Nginx deployment.
CORS_ORIGINS=
# Set true only when the backend sits behind a trusted TLS reverse proxy.
TRUST_PROXY=false
WHATSAPP_TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
WHATSAPP_GRAPH_API_VERSION=v23.0
TRACCAR_API_URL=http://traccar:8082/api
TRACCAR_API_USER=replace-with-traccar-api-username
TRACCAR_API_PASSWORD=replace-with-traccar-api-password

# Used by Traccar because CONFIG_USE_ENVIRONMENT_VARIABLES=true.
TRACCAR_DATABASE_DRIVER=com.mysql.cj.jdbc.Driver
TRACCAR_DATABASE_URL=jdbc:mysql://mysql:3306/traccar?zeroDateTimeBehavior=round&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false&allowMultiQueries=true&autoReconnect=true&useUnicode=yes&characterEncoding=UTF-8&sessionVariables=sql_mode=''
TRACCAR_DATABASE_USER=traccar
TRACCAR_DATABASE_PASSWORD=change-this-database-password
