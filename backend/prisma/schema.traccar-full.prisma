  lastupdate                                                   DateTime?                @db.Timestamp(0)
  positionid                                                   Int?
  groupid                                                      Int?
  attributes                                                   String?                  @db.VarChar(4000)
  phone                                                        String?                  @db.VarChar(128)
  model                                                        String?                  @db.VarChar(128)
  contact                                                      String?                  @db.VarChar(512)
  category                                                     String?                  @db.VarChar(128)
  disabled                                                     Int?                     @default(0) @db.TinyInt
  status                                                       String?                  @db.Char(8)
  expirationtime                                               DateTime?                @db.Timestamp(0)
  motionstate                                                  Int?                     @default(0) @db.TinyInt
  motiontime                                                   DateTime?                @db.Timestamp(0)
  motiondistance                                               Float?                   @default(0)
  overspeedstate                                               Int?                     @default(0) @db.TinyInt
  overspeedtime                                                DateTime?                @db.Timestamp(0)
  overspeedgeofenceid                                          Int?                     @default(0)
  motionstreak                                                 Int?                     @default(0) @db.TinyInt
  calendarid                                                   Int?
  motionpositionid                                             Int?
  motionlatitude                                               Float?                   @default(0)
  motionlongitude                                              Float?                   @default(0)
  tc_commands_queue                                            tc_commands_queue[]
  tc_device_attribute                                          tc_device_attribute[]
  tc_device_command                                            tc_device_command[]
  tc_device_device_tc_device_device_deviceidTotc_devices       tc_device_device[]       @relation("tc_device_device_deviceidTotc_devices")
  tc_device_device_tc_device_device_linkeddeviceidTotc_devices tc_device_device[]       @relation("tc_device_device_linkeddeviceidTotc_devices")
  tc_device_driver                                             tc_device_driver[]
  tc_device_geofence                                           tc_device_geofence[]
  tc_device_maintenance                                        tc_device_maintenance[]
  tc_device_notification                                       tc_device_notification[]
  tc_device_order                                              tc_device_order[]
  tc_device_report                                             tc_device_report[]
  tc_calendars                                                 tc_calendars?            @relation(fields: [calendarid], references: [id], onUpdate: Restrict, map: "fk_devices_calendarid")
  tc_groups                                                    tc_groups?               @relation(fields: [groupid], references: [id], onUpdate: Restrict, map: "fk_devices_groupid")
  tc_user_device                                               tc_user_device[]

  @@index([calendarid], map: "fk_devices_calendarid")
  @@index([groupid], map: "fk_devices_groupid")
  @@index([uniqueid], map: "idx_devices_uniqueid")
}

