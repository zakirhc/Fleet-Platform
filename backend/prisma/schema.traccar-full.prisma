generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid      String    @unique(map: "uk_company_uuid") @db.Char(36)
  code      String    @unique(map: "uk_company_code") @db.VarChar(20)
  name      String    @db.VarChar(150)
  email     String?   @db.VarChar(150)
  phone     String?   @db.VarChar(30)
  address   String?   @db.VarChar(255)
  website   String?   @db.VarChar(150)
  timezone  String    @default("Asia/Dhaka") @db.VarChar(64)
  is_active Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  fm_driver Driver[]
  users     User[]
  vehicles  Vehicle[]

  @@map("fm_company")
}

model User {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  uuid         String         @unique(map: "uuid") @db.Char(36)
  companyId    BigInt         @map("company_id") @db.UnsignedBigInt
  username     String         @unique(map: "username") @db.VarChar(100)
  email        String?        @db.VarChar(150)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  fullName     String?        @map("full_name") @db.VarChar(150)
  phone        String?        @db.VarChar(30)
  status       UserStatus?    @default(ACTIVE)
  lastLoginAt  DateTime?      @map("last_login_at") @db.DateTime(0)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  company      Company        @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_user_company")
  fm_user_role fm_user_role[]

  @@index([companyId], map: "fk_user_company")
  @@map("fm_user")
}

model Vehicle {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  companyId         BigInt             @map("company_id") @db.UnsignedBigInt
  traccarDeviceId   BigInt?            @map("traccar_device_id")
  registrationNo    String             @map("registration_no") @db.VarChar(50)
  fleetNo           String?            @map("fleet_no") @db.VarChar(50)
  vehicleTypeId     BigInt?            @map("vehicle_type_id")
  make              String?            @db.VarChar(100)
  model             String?            @db.VarChar(100)
  year              Int?               @db.SmallInt
  chassisNo         String?            @map("chassis_no") @db.VarChar(100)
  engineNo          String?            @map("engine_no") @db.VarChar(100)
  color             String?            @db.VarChar(30)
  fuelType          String?            @map("fuel_type") @db.VarChar(30)
  status            VehicleStatus?     @default(ACTIVE)
  remarks           String?            @db.Text
  createdAt         DateTime?          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime?          @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt         DateTime?          @map("deleted_at") @db.DateTime(0)
  company           Company            @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_vehicle_company")
  fm_vehicle_device fm_vehicle_device?
assignments VehicleDriverAssignment[]
  @@index([companyId], map: "idx_company")
  @@index([traccarDeviceId], map: "idx_device")
  @@map("fm_vehicle")
}

model Driver {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid               String   @unique @default(uuid()) @db.Char(36)

  companyId          BigInt   @map("company_id") @db.UnsignedBigInt
  employeeNo         String?  @map("employee_no") @db.VarChar(30)

  fullName           String   @map("full_name") @db.VarChar(150)
  designation        String?  @db.VarChar(100)
  department         String?  @db.VarChar(100)

  mobile             String?  @db.VarChar(30)
  email              String?  @db.VarChar(150)

  licenseNo          String?  @map("license_no") @db.VarChar(50)
  licenseType        String?  @map("license_type") @db.VarChar(30)
  licenseIssueDate   DateTime? @map("license_issue_date") @db.Date
  licenseExpiry      DateTime? @map("license_expiry") @db.Date

  nid                String?  @db.VarChar(30)
  passportNo         String?  @map("passport_no") @db.VarChar(30)

  bloodGroup         String?  @map("blood_group") @db.VarChar(5)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  joiningDate        DateTime? @map("joining_date") @db.Date

  address            String? @db.Text

  emergencyName      String? @map("emergency_name") @db.VarChar(150)
  emergencyPhone     String? @map("emergency_phone") @db.VarChar(30)

  photo              String? @db.VarChar(255)

  status             DriverStatus @default(ACTIVE)

  remarks            String? @db.Text

  createdBy          BigInt? @map("created_by")
  updatedBy          BigInt? @map("updated_by")
  deletedBy          BigInt? @map("deleted_by")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  company Company @relation(fields:[companyId], references:[id])

  assignments VehicleDriverAssignment[]

  @@index([companyId])
  @@unique([companyId, employeeNo])
  @@map("fm_driver")
}

model VehicleDriverAssignment {

  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  vehicleId BigInt @map("vehicle_id")
  driverId BigInt @map("driver_id")

  assignedAt DateTime @default(now()) @map("assigned_at")
  releasedAt DateTime? @map("released_at")

  assignedBy BigInt? @map("assigned_by")

  remarks String? @db.Text

  active Boolean @default(true)

  vehicle Vehicle @relation(fields:[vehicleId], references:[id])

  driver Driver @relation(fields:[driverId], references:[id])

  @@index([vehicleId])
  @@index([driverId])
  @@index([active])

  @@map("fm_vehicle_driver")
}

