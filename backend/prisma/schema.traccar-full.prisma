}

model fm_role_permission {
  role_id       BigInt        @db.UnsignedBigInt
  permission_id BigInt        @db.UnsignedBigInt
  fm_permission fm_permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rolepermission_permission")
  fm_role       fm_role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rolepermission_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_rolepermission_permission")
}

