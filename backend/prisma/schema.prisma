generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Fleet management tables. These are owned by the Fleet Platform.
model Company {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid      String   @unique(map: "uk_company_uuid") @db.Char(36)
  code      String   @unique(map: "uk_company_code") @db.VarChar(20)
  name      String   @db.VarChar(150)
  email     String?  @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  address   String?  @db.VarChar(255)
  website   String?  @db.VarChar(150)
  timezone  String   @default("Asia/Dhaka") @db.VarChar(64)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  drivers          Driver[]
  users            User[]
  vehicles         Vehicle[]
  whatsappAccounts WhatsappAccount[]
  whatsappMessages WhatsappMessage[]
  geofences       FleetGeofence[]
  alertRules      AlertRule[]
  maintenanceSchedules MaintenanceSchedule[]
  workOrders WorkOrder[]
  fuelRecords FuelRecord[]
  expenseRecords ExpenseRecord[]
  reportSchedules ReportSchedule[]
  documents FleetDocument[]
  mobileDevices MobileDevice[]

  @@map("fm_company")
}

model User {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  uuid         String     @unique(map: "uuid") @db.Char(36)
  companyId    BigInt     @map("company_id") @db.UnsignedBigInt
  username     String     @unique(map: "username") @db.VarChar(100)
  email        String?    @db.VarChar(150)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(150)
  phone        String?    @db.VarChar(30)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.DateTime(0)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamp(0)

  company Company        @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_user_company")
  roles   fm_user_role[]
  authSessions AuthSession[]
  mobileDevices MobileDevice[]

  @@index([companyId], map: "fk_user_company")
  @@map("fm_user")
}

model AuthSession {
  id               String    @id @db.Char(36)
  userId           BigInt    @map("user_id") @db.UnsignedBigInt
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  lastUsedAt       DateTime? @map("last_used_at") @db.DateTime(0)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_auth_session_user")

  @@index([userId, revokedAt, expiresAt], map: "idx_auth_session_user_active")
  @@map("fm_auth_session")
}

model MobileDevice {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  companyId  BigInt   @map("company_id") @db.UnsignedBigInt
  userId     BigInt   @map("user_id") @db.UnsignedBigInt
  platform   String   @default("ANDROID") @db.VarChar(20)
  fcmToken   String   @unique(map: "uk_mobile_device_fcm_token") @map("fcm_token") @db.VarChar(512)
  deviceName String?  @map("device_name") @db.VarChar(150)
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.DateTime(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  company    Company  @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_mobile_device_company")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_mobile_device_user")

  @@index([companyId, active], map: "idx_mobile_device_company_active")
  @@index([userId, active], map: "idx_mobile_device_user_active")
  @@map("fm_mobile_device")
}

model Vehicle {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  companyId       BigInt        @map("company_id") @db.UnsignedBigInt
  traccarDeviceId BigInt?       @map("traccar_device_id") @db.UnsignedBigInt
  registrationNo  String        @map("registration_no") @db.VarChar(50)
  fleetNo         String?       @map("fleet_no") @db.VarChar(50)
  vehicleTypeId   BigInt?       @map("vehicle_type_id") @db.UnsignedBigInt
  make            String?       @db.VarChar(100)
  model           String?       @db.VarChar(100)
  year            Int?          @db.SmallInt
  chassisNo       String?       @map("chassis_no") @db.VarChar(100)
  engineNo        String?       @map("engine_no") @db.VarChar(100)
  color           String?       @db.VarChar(30)
  fuelType        String?       @map("fuel_type") @db.VarChar(30)
  status          VehicleStatus @default(ACTIVE)
  remarks         String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt       DateTime?     @map("deleted_at") @db.DateTime(0)

  company     Company                   @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_vehicle_company")
  deviceLink  fm_vehicle_device?
  assignments VehicleDriverAssignment[]
  maintenanceSchedules MaintenanceSchedule[]
  workOrders WorkOrder[]
  fuelRecords FuelRecord[]
  expenseRecords ExpenseRecord[]
  documents FleetDocument[]

  @@unique([companyId, registrationNo])
  @@index([companyId], map: "idx_company")
  @@index([traccarDeviceId], map: "idx_device")
  @@map("fm_vehicle")
}

model Driver {
  id               BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  uuid             String       @unique(map: "uk_driver_uuid") @default(uuid()) @db.Char(36)
  companyId        BigInt       @map("company_id") @db.UnsignedBigInt
  employeeNo       String?      @map("employee_no") @db.VarChar(30)
  fullName         String       @map("full_name") @db.VarChar(150)
  designation      String?      @db.VarChar(100)
  department       String?      @db.VarChar(100)
  mobile           String?      @db.VarChar(30)
  email            String?      @db.VarChar(150)
  licenseNo        String?      @map("license_no") @db.VarChar(50)
  licenseType      String?      @map("license_type") @db.VarChar(30)
  licenseIssueDate DateTime?    @map("license_issue_date") @db.Date
  licenseExpiry    DateTime?    @map("license_expiry") @db.Date
  nid              String?      @db.VarChar(30)
  passportNo       String?      @map("passport_no") @db.VarChar(30)
  bloodGroup       String?      @map("blood_group") @db.VarChar(5)
  dateOfBirth      DateTime?    @map("date_of_birth") @db.Date
  joiningDate      DateTime?    @map("joining_date") @db.Date
  address          String?      @db.Text
  emergencyName    String?      @map("emergency_name") @db.VarChar(150)
  emergencyPhone   String?      @map("emergency_phone") @db.VarChar(30)
  photo            String?      @db.VarChar(255)
  status           DriverStatus @default(ACTIVE)
  remarks          String?      @db.Text
  createdBy        BigInt?      @map("created_by") @db.UnsignedBigInt
  updatedBy        BigInt?      @map("updated_by") @db.UnsignedBigInt
  deletedBy        BigInt?      @map("deleted_by") @db.UnsignedBigInt
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt        DateTime?    @map("deleted_at") @db.DateTime(0)

  company     Company                   @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_driver_company")
  assignments VehicleDriverAssignment[]
  documents FleetDocument[]

  @@unique([companyId, employeeNo], map: "uk_driver_employee")
  @@unique([companyId, licenseNo], map: "uk_driver_license")
  @@index([companyId], map: "idx_driver_company")
  @@index([fullName], map: "idx_driver_name")
  @@index([mobile], map: "idx_driver_mobile")
  @@map("fm_driver")
}

model VehicleDriverAssignment {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  vehicleId  BigInt    @map("vehicle_id") @db.UnsignedBigInt
  driverId   BigInt    @map("driver_id") @db.UnsignedBigInt
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.DateTime(0)
  releasedAt DateTime? @map("released_at") @db.DateTime(0)
  assignedBy BigInt?   @map("assigned_by") @db.UnsignedBigInt
  remarks    String?   @db.Text
  active     Boolean   @default(true)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onUpdate: Restrict, map: "fk_vehicle_driver_vehicle")
  driver  Driver  @relation(fields: [driverId], references: [id], onUpdate: Restrict, map: "fk_vehicle_driver_driver")

  @@index([vehicleId])
  @@index([driverId])
  @@index([active])
  @@map("fm_vehicle_driver")
}

model WhatsappAccount {
  id                    BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  companyId             BigInt   @map("company_id") @db.UnsignedBigInt
  phoneNumberId         String   @unique(map: "uk_whatsapp_account_phone_number") @map("phone_number_id") @db.VarChar(64)
  displayName           String?  @map("display_name") @db.VarChar(150)
  accessTokenCiphertext String   @map("access_token_ciphertext") @db.Text
  verifyTokenCiphertext String   @map("verify_token_ciphertext") @db.Text
  appSecretCiphertext   String?  @map("app_secret_ciphertext") @db.Text
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  company  Company           @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_whatsapp_account_company")
  messages WhatsappMessage[]

  @@index([companyId], map: "idx_whatsapp_account_company")
  @@map("fm_whatsapp_account")
}

model WhatsappMessage {
  id                BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  companyId         BigInt                   @map("company_id") @db.UnsignedBigInt
  accountId         BigInt                   @map("account_id") @db.UnsignedBigInt
  direction         WhatsappMessageDirection
  recipient         String                   @db.VarChar(32)
  body              String                   @db.Text
  status            WhatsappMessageStatus    @default(QUEUED)
  providerMessageId String?                  @unique(map: "uk_whatsapp_message_provider") @map("provider_message_id") @db.VarChar(128)
  errorMessage      String?                  @map("error_message") @db.Text
  sentAt            DateTime?                @map("sent_at") @db.DateTime(0)
  deliveredAt       DateTime?                @map("delivered_at") @db.DateTime(0)
  readAt            DateTime?                @map("read_at") @db.DateTime(0)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.DateTime(0)

  company Company         @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_whatsapp_message_company")
  account WhatsappAccount @relation(fields: [accountId], references: [id], onUpdate: Restrict, map: "fk_whatsapp_message_account")

  @@index([companyId, createdAt], map: "idx_whatsapp_message_company_created")
  @@index([accountId, createdAt], map: "idx_whatsapp_message_account_created")
  @@map("fm_whatsapp_message")
}

model FleetGeofence {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  companyId    BigInt    @map("company_id") @db.UnsignedBigInt
  tcGeofenceId Int       @map("tc_geofence_id")
  name         String    @db.VarChar(128)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  company    Company     @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_fm_geofence_company")
  alertRules AlertRule[]

  @@unique([companyId, tcGeofenceId], map: "uk_fm_geofence_company_tc")
  @@index([companyId, active], map: "idx_fm_geofence_company_active")
  @@map("fm_geofence")
}

model AlertRule {
  id          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  companyId   BigInt          @map("company_id") @db.UnsignedBigInt
  geofenceId BigInt          @map("geofence_id") @db.UnsignedBigInt
  eventType   GeofenceEventType @map("event_type")
  recipient   String          @db.VarChar(32)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(0)

  company   Company        @relation(fields: [companyId], references: [id], onUpdate: Restrict, map: "fk_alert_rule_company")
  geofence FleetGeofence  @relation(fields: [geofenceId], references: [id], onUpdate: Restrict, map: "fk_alert_rule_geofence")
  deliveries AlertDelivery[]

  @@index([companyId, active], map: "idx_alert_rule_company_active")
  @@index([geofenceId], map: "idx_alert_rule_geofence")
  @@map("fm_alert_rule")
}

model AlertDelivery {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  alertRuleId    BigInt   @map("alert_rule_id") @db.UnsignedBigInt
  tcEventId      Int      @map("tc_event_id")
  whatsappMessageId BigInt? @map("whatsapp_message_id") @db.UnsignedBigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)

  alertRule       AlertRule        @relation(fields: [alertRuleId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_alert_delivery_rule")

  @@unique([alertRuleId, tcEventId], map: "uk_alert_delivery_rule_event")
  @@index([createdAt], map: "idx_alert_delivery_created")
  @@map("fm_alert_delivery")
}

model MaintenanceSchedule {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  companyId BigInt @map("company_id") @db.UnsignedBigInt
  vehicleId BigInt @map("vehicle_id") @db.UnsignedBigInt
  name String @db.VarChar(150)
  intervalDays Int? @map("interval_days")
  dueDate DateTime? @map("due_date") @db.Date
  dueOdometer Float? @map("due_odometer")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  company Company @relation(fields:[companyId], references:[id], onUpdate:Restrict, map:"fk_maintenance_schedule_company")
  vehicle Vehicle @relation(fields:[vehicleId], references:[id], onUpdate:Restrict, map:"fk_maintenance_schedule_vehicle")
  workOrders WorkOrder[]
  @@index([companyId, active], map:"idx_maintenance_schedule_company_active")
  @@index([vehicleId], map:"idx_maintenance_schedule_vehicle")
  @@map("fm_maintenance_schedule")
}

model WorkOrder {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  companyId BigInt @map("company_id") @db.UnsignedBigInt
  vehicleId BigInt @map("vehicle_id") @db.UnsignedBigInt
  scheduleId BigInt? @map("schedule_id") @db.UnsignedBigInt
  number String @db.VarChar(50)
  title String @db.VarChar(150)
  status WorkOrderStatus @default(OPEN)
  vendor String? @db.VarChar(150)
  openedAt DateTime @default(now()) @map("opened_at") @db.DateTime(0)
  completedAt DateTime? @map("completed_at") @db.DateTime(0)
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(12,2)
  actualCost Decimal? @map("actual_cost") @db.Decimal(12,2)
  notes String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  company Company @relation(fields:[companyId], references:[id], onUpdate:Restrict, map:"fk_work_order_company")
  vehicle Vehicle @relation(fields:[vehicleId], references:[id], onUpdate:Restrict, map:"fk_work_order_vehicle")
  schedule MaintenanceSchedule? @relation(fields:[scheduleId], references:[id], onUpdate:Restrict, map:"fk_work_order_schedule")
  @@unique([companyId, number], map:"uk_work_order_company_number")
  @@index([vehicleId, status], map:"idx_work_order_vehicle_status")
  @@map("fm_work_order")
}

model FuelRecord {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  companyId BigInt @map("company_id") @db.UnsignedBigInt
  vehicleId BigInt @map("vehicle_id") @db.UnsignedBigInt
  filledAt DateTime @map("filled_at") @db.DateTime(0)
  litres Decimal @db.Decimal(10,3)
  totalAmount Decimal @map("total_amount") @db.Decimal(12,2)
  odometer Float?
  station String? @db.VarChar(150)
  notes String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  company Company @relation(fields:[companyId], references:[id], onUpdate:Restrict, map:"fk_fuel_record_company")
  vehicle Vehicle @relation(fields:[vehicleId], references:[id], onUpdate:Restrict, map:"fk_fuel_record_vehicle")
  @@index([companyId, filledAt], map:"idx_fuel_record_company_date")
  @@index([vehicleId, filledAt], map:"idx_fuel_record_vehicle_date")
  @@map("fm_fuel_record")
}

model ExpenseRecord {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  companyId BigInt @map("company_id") @db.UnsignedBigInt
  vehicleId BigInt? @map("vehicle_id") @db.UnsignedBigInt
  category String @db.VarChar(80)
  expenseDate DateTime @map("expense_date") @db.Date
  amount Decimal @db.Decimal(12,2)
  vendor String? @db.VarChar(150)
  description String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  company Company @relation(fields:[companyId], references:[id], onUpdate:Restrict, map:"fk_expense_record_company")
  vehicle Vehicle? @relation(fields:[vehicleId], references:[id], onUpdate:Restrict, map:"fk_expense_record_vehicle")
  @@index([companyId, expenseDate], map:"idx_expense_record_company_date")
  @@map("fm_expense_record")
}

model ReportSchedule {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  companyId BigInt @map("company_id") @db.UnsignedBigInt
  reportType ReportType @map("report_type")
  frequency ReportFrequency
  recipient String? @db.VarChar(150)
  active Boolean @default(true)
  lastRunAt DateTime? @map("last_run_at") @db.DateTime(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  company Company @relation(fields:[companyId], references:[id], onUpdate:Restrict, map:"fk_report_schedule_company")
  @@index([companyId, active], map:"idx_report_schedule_company_active")
  @@map("fm_report_schedule")
}

model FleetDocument {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  companyId BigInt @map("company_id") @db.UnsignedBigInt
  vehicleId BigInt? @map("vehicle_id") @db.UnsignedBigInt
  driverId BigInt? @map("driver_id") @db.UnsignedBigInt
  name String @db.VarChar(150)
  documentType String? @map("document_type") @db.VarChar(80)
  fileUrl String @map("file_url") @db.VarChar(500)
  expiresAt DateTime? @map("expires_at") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  company Company @relation(fields:[companyId],references:[id],onUpdate:Restrict,map:"fk_document_company")
  vehicle Vehicle? @relation(fields:[vehicleId],references:[id],onUpdate:Restrict,map:"fk_document_vehicle")
  driver Driver? @relation(fields:[driverId],references:[id],onUpdate:Restrict,map:"fk_document_driver")
  @@index([companyId, expiresAt],map:"idx_document_company_expiry")
  @@map("fm_document")
}

model fm_permission {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  code               String               @unique(map: "uk_permission_code") @db.VarChar(100)
  name               String               @db.VarChar(150)
  fm_role_permission fm_role_permission[]
}

model fm_role {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  code               String               @unique(map: "uk_role_code") @db.VarChar(50)
  name               String               @db.VarChar(100)
  description        String?              @db.VarChar(255)
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  fm_role_permission fm_role_permission[]
  fm_user_role       fm_user_role[]
}

model fm_role_permission {
  role_id       BigInt        @db.UnsignedBigInt
  permission_id BigInt        @db.UnsignedBigInt
  fm_permission fm_permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rolepermission_permission")
  fm_role       fm_role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rolepermission_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_rolepermission_permission")
}

model fm_schema_version {
  version      Int      @id
  description  String   @db.VarChar(255)
  installed_at DateTime @default(now()) @db.Timestamp(0)
}

model fm_user_role {
  user_id BigInt  @db.UnsignedBigInt
  role_id BigInt  @db.UnsignedBigInt
  fm_role fm_role @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_userrole_role")
  fm_user User    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_userrole_user")

  @@id([user_id, role_id])
  @@index([role_id], map: "fk_userrole_role")
}

model fm_vehicle_device {
  vehicle_id   BigInt   @id @db.UnsignedBigInt
  tc_device_id BigInt   @unique(map: "uk_vehicle_device_tc_device") @db.UnsignedBigInt
  assigned_at  DateTime @default(now()) @db.Timestamp(0)
  fm_vehicle   Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fm_vehicle_device_ibfk_1")
}

// Read-only operational subset of the shared Traccar database. Models are kept
// relation-free intentionally: Traccar's association tables are not consistently
// keyed across versions, while the Fleet Platform only needs these records by ID.
model tc_devices {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(128)
  uniqueid            String    @unique(map: "uniqueid") @db.VarChar(128)
  lastupdate          DateTime? @db.Timestamp(0)
  positionid          Int?
  groupid             Int?
  attributes          String?   @db.VarChar(4000)
  phone               String?   @db.VarChar(128)
  model               String?   @db.VarChar(128)
  contact             String?   @db.VarChar(512)
  category            String?   @db.VarChar(128)
  disabled            Int?      @default(0) @db.TinyInt
  status              String?   @db.Char(8)
  expirationtime      DateTime? @db.Timestamp(0)
  motionstate         Int?      @default(0) @db.TinyInt
  motiontime          DateTime? @db.Timestamp(0)
  motiondistance      Float?    @default(0)
  overspeedstate      Int?      @default(0) @db.TinyInt
  overspeedtime       DateTime? @db.Timestamp(0)
  overspeedgeofenceid Int?      @default(0)
  motionstreak        Int?      @default(0) @db.TinyInt
  calendarid          Int?
  motionpositionid    Int?
  motionlatitude      Float?    @default(0)
  motionlongitude     Float?    @default(0)

  @@index([groupid], map: "fk_devices_groupid")
}

model tc_positions {
  id          Int      @id @default(autoincrement())
  protocol    String?  @db.VarChar(128)
  deviceid    Int
  servertime  DateTime @default(now()) @db.Timestamp(0)
  devicetime  DateTime @default(dbgenerated("'0000-00-00 00:00:00'")) @db.Timestamp(0)
  fixtime     DateTime @default(dbgenerated("'0000-00-00 00:00:00'")) @db.Timestamp(0)
  valid       Int      @db.TinyInt
  latitude    Float
  longitude   Float
  altitude    Float    @db.Float
  speed       Float    @db.Float
  course      Float    @db.Float
  address     String?  @db.VarChar(512)
  attributes  String?  @db.VarChar(4000)
  accuracy    Float    @default(0)
  network     String?  @db.VarChar(4000)
  geofenceids String?  @db.VarChar(128)

  @@index([deviceid, fixtime], map: "position_deviceid_fixtime")
}

model tc_events {
  id            Int      @id @default(autoincrement())
  type          String   @db.VarChar(128)
  eventtime     DateTime @default(now()) @db.Timestamp(0)
  deviceid      Int?
  positionid    Int?
  geofenceid    Int?
  attributes    String?  @db.VarChar(4000)
  maintenanceid Int?

  @@index([deviceid, eventtime], map: "event_deviceid_servertime")
}

model tc_geofences {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(128)
  description String? @db.VarChar(128)
  area        String  @db.VarChar(4096)
  attributes  String? @db.VarChar(4000)
  calendarid  Int?
}

model tc_groups {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(128)
  groupid    Int?
  attributes String? @db.VarChar(4000)

  @@index([groupid], map: "fk_groups_groupid")
}

model tc_drivers {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(128)
  uniqueid   String @unique(map: "uniqueid") @db.VarChar(128)
  attributes String @db.VarChar(4000)
}

model tc_maintenances {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(4000)
  type       String @db.VarChar(128)
  start      Float  @default(0)
  period     Float  @default(0)
  attributes String @db.VarChar(4000)
}

model tc_notifications {
  id           Int     @id @default(autoincrement())
  type         String  @db.VarChar(128)
  attributes   String? @db.VarChar(4000)
  always       Int     @default(0) @db.TinyInt
  calendarid   Int?
  notificators String? @db.VarChar(128)
  commandid    Int?
  description  String? @db.VarChar(4000)
}

model tc_commands {
  id          Int    @id @default(autoincrement())
  description String @db.VarChar(4000)
  type        String @db.VarChar(128)
  textchannel Int    @default(0) @db.TinyInt
  attributes  String @db.VarChar(4000)
}

model tc_calendars {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(128)
  data       Bytes  @db.MediumBlob
  attributes String @db.VarChar(4000)
}

